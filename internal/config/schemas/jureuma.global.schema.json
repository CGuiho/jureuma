{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jureuma global configuration (jureuma.global.yaml)",
  "description": "User-wide configuration for the jureuma CLI, stored in ~/.guiho/jureuma/jureuma.global.yaml.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protections": {
      "description": "Global-only protection settings. Never read from jureuma.yaml.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowBypass": {
          "description": "false disables --dangerously-bypass-protections. Default true.",
          "type": "boolean"
        },
        "agentEnvMarkers": {
          "description": "Extra environment variable names that identify an AI agent.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      }
    },
    "agent": { "$ref": "#/$defs/agent" }
  },
  "$defs": {
    "policy": {
      "description": "Agent evolution policy.",
      "enum": ["disabled", "always-ask", "always-proceed"]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evolution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "upgrade": { "$ref": "#/$defs/policy" },
            "issues": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bugs": { "$ref": "#/$defs/policy" },
                "improvements": { "$ref": "#/$defs/policy" },
                "reviews": { "$ref": "#/$defs/policy" }
              }
            }
          }
        }
      }
    }
  }
}
